#!/usr/bin/env python3
"""Launch HyprLarp or address its IPC endpoint without a shell intermediary."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parents[1]
PANELS = {
  "launcher", "control", "wifi", "bluetooth", "notifications", "clipboard", "media", "calendar",
  "session", "resources", "battery", "wallpapers", "capture", "audio", "brightness", "presentation",
  "energy", "night-light", "usb", "osd", "displays", "performance"
}


def runtime() -> str:
  for executable in [os.environ.get("HYPRLARP_QUICKSHELL", "quickshell"), "qs"]:
    binary = shutil.which(executable)
    if binary:
      return binary
  raise RuntimeError("Instala Quickshell 0.3.2+ antes de iniciar HyprLarp")


def ipc(binary: str, method: str, *arguments: str, quiet: bool = False) -> bool:
  result = subprocess.run([binary, "--path", str(ROOT / "shell.qml"), "ipc", "call", "shell", method, *arguments],
              capture_output=True, text=True)
  if result.returncode and result.stderr and not quiet:
    print(result.stderr.strip(), file=sys.stderr)
  return result.returncode == 0


def doctor(*, json_output=False, report_path=None, include_logs=True) -> int:
  sys.path.insert(0, str(ROOT))
  from backend import diagnostics
  import json
  report = diagnostics.collect(ROOT, include_logs=include_logs)
  if report_path:
    diagnostics.export(report, report_path)
  print(json.dumps(report, ensure_ascii=False, indent=2) if json_output else diagnostics.render(report))
  if report_path and not json_output:
    print("\nInforme guardado: " + str(report_path))
  return int(not report["ok"])


def main() -> int:
  parser = argparse.ArgumentParser(description="HyprLarp · shell para Hyprland")
  parser.add_argument("command", nargs="?", default="run", choices=["run", "start", "stop", "ready", "session-check", "recover", "retry", "preview", "settings", "toggle", "close", "lock", "screenshot-region", "screenshot-region-frozen", "screenshot-screen", "screenshot-window", "doctor", "install", "uninstall"])
  parser.add_argument("panel", nargs="?", choices=sorted(PANELS))
  parser.add_argument("--dry-run", action="store_true", help="Mostrar los archivos de instalación")
  parser.add_argument("--prefix", type=Path, help="Directorio de una instalación aislada")
  parser.add_argument("--purge", action="store_true", help="Eliminar toda la carpeta de ajustes, incluidos historiales y respaldos internos")
  parser.add_argument("--json", action="store_true", help="Diagnóstico en formato JSON")
  parser.add_argument("--report", type=Path, help="Guardar el diagnóstico en un archivo JSON privado")
  parser.add_argument("--no-logs", action="store_true", help="Omitir registros recientes del diagnóstico")
  parser.add_argument("--freeze", action="store_true", help="Congelar la pantalla durante la selección de la captura")
  args = parser.parse_args()
  if args.freeze and not args.command.startswith("screenshot-"):
    parser.error("--freeze solo se admite con los comandos screenshot-*")
  if args.command == "doctor":
    return doctor(json_output=args.json, report_path=args.report, include_logs=not args.no_logs)
  if args.purge and args.command != "uninstall":
    parser.error("--purge solo se admite con uninstall")
  if args.command in {"install", "uninstall"}:
    options = (["--dry-run"] if args.dry_run else []) + (["--prefix", str(args.prefix)] if args.prefix else []) + (["--purge"] if args.purge else [])
    return subprocess.call([sys.executable, str(ROOT / ("tools/" + args.command + ".py"))] + options)
  sys.path.insert(0, str(ROOT))
  if args.command == "session-check":
    from backend.recovery import session_alive
    return 0 if session_alive() else 1
  if args.command in {"recover", "retry"}:
    from backend.supervisor import request
    request(ROOT, 'recovery' if args.command == 'recover' else 'normal')
    return 0
  binary = runtime()
  if args.command in {"start", "stop", "ready"}:
    from backend import recovery
    if args.command == "start":
      # The installed user launcher is the stable entry point used by the unit.
      config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
      executable = Path(os.environ.get("HYPRLARP_EXECUTABLE", Path.home() / ".local/bin/hyprlarp"))
      recovery.start(ROOT, executable, binary, destination=recovery.unit_path(config))
    elif args.command == "stop":
      recovery.stop(ROOT, binary)
    else:
      recovery.wait_ready(ROOT, binary, timeout=50)
    return 0
  environment = {**os.environ, "HYPRLARP_EXECUTABLE": str(Path(__file__).resolve()), "PYTHONDONTWRITEBYTECODE": "1", "QT_LINUX_ACCESSIBILITY_ALWAYS_ON": "1"}
  sys.path.insert(0, str(ROOT))
  from backend.icons import choose_icon_theme
  icon_theme = choose_icon_theme(environment)
  if icon_theme:
    environment.setdefault("QS_ICON_THEME", icon_theme)
  if args.command in {"run", "preview"}:
    entrypoint = ROOT / "shell.qml"
    if args.command == "preview":
      entrypoint = ROOT / "preview.qml"
      environment["HYPRLARP_PREVIEW"] = "1"
      cache = Path(environment.get("XDG_CACHE_HOME", str(Path.home() / ".cache")))
      environment.setdefault("HYPRLARP_STATE_DIR", str(cache / "hyprlarp/preview"))
    if args.command == "run":
      from backend.supervisor import supervise
      return supervise(ROOT, binary, environment)
    os.execvpe(binary, [binary, "--path", str(entrypoint), "--no-duplicate"], environment)
  if args.command == "settings":
    if ipc(binary, "settings", quiet=True):
      return 0
    environment["HYPRLARP_SETTINGS_ONLY"] = "1"
    os.execvpe(binary, [binary, "--path", str(ROOT / "settings.qml"), "--no-duplicate"], environment)
  if args.command == "toggle":
    if not args.panel:
      parser.error("toggle necesita el nombre de un panel")
    return 0 if ipc(binary, "toggle", args.panel) else 1
  if args.command == "close":
    return 0 if ipc(binary, "close") else 1
  if args.command == "lock":
    sys.path.insert(0, str(ROOT))
    from backend.service import Service
    Service.session("lock")
    return 0
  if args.command.startswith("screenshot-"):
    frozen = args.freeze or args.command == "screenshot-region-frozen"
    mode = args.command.removeprefix("screenshot-").removesuffix("-frozen")
    return 0 if ipc(binary, "captureFrozen" if frozen else "capture", mode) else 1
  return 0


if __name__ == "__main__":
  try:
    sys.exit(main())
  except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
    print(f"HyprLarp: {error}", file=sys.stderr)
    sys.exit(1)
